<Window x:Class="EMP_record_management.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Management"
        Height="600"
        Width="850"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Employee Management"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Employee input -->
        <GroupBox Header="Employee Details"
                  Grid.Row="1"
                  Padding="12"
                  Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Name:" Grid.Row="0" Grid.Column="0"/>
                <TextBox x:Name="NameTextBox"
                         Grid.Row="0" Grid.Column="1"
                         Margin="5"/>

                <Label Content="Age:" Grid.Row="0" Grid.Column="2"/>
                <TextBox x:Name="AgeTextBox"
                         Grid.Row="0" Grid.Column="3"
                         Margin="5"/>

                <Label Content="Salary:" Grid.Row="1" Grid.Column="0"/>
                <TextBox x:Name="SalaryTextBox"
                         Grid.Row="1" Grid.Column="1"
                         Margin="5"/>

                <Button Content="Add Employee"
                        Grid.Row="1" Grid.Column="3"
                        Margin="132,5,110,5"
                        Padding="10,5"
                        Click="AddButton_Click"/>
                <Button Content="INIT ()"
                        Grid.Row="1" Grid.Column="3"
                        Margin="5,5,230,5"
                        Padding="10,5"
                        Click="InitButton_Click"/>
                <Button Content="Clear"
                    Grid.Row="1" Grid.Column="3"
                    Margin="249,5,0,5"
                    Padding="10,5"
                    Click="ClearButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- Employee list -->
        <ListView x:Name="EmployeeListView"
                  Grid.Row="2"
                  Margin="0,0,0,15">

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name"
                                    DisplayMemberBinding="{Binding Name}"
                                    Width="200"/>
                    <GridViewColumn Header="Age"
                                    DisplayMemberBinding="{Binding Age}"
                                    Width="100"/>
                    <GridViewColumn Header="Salary"
                                    DisplayMemberBinding="{Binding Salary}"
                                    Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- File operations -->
        <GroupBox Header="File Operations"
                  Grid.Row="3"
                  Padding="10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Content="File Path:"
                       Grid.Column="0"/>

                <TextBox x:Name="FilePathTextBox"
                         Grid.Column="1"
                         Margin="5"/>

                <ComboBox x:Name="FormatComboBox"
                          Grid.Column="2"
                          Width="90"
                          Margin="5"
                          SelectedIndex="0">
                    <ComboBoxItem Content="TXT"/>
                    <ComboBoxItem Content="CSV"/>
                    <ComboBoxItem Content="JSON"/>
                </ComboBox>

                <Button Content="Save"
                        Grid.Column="3"
                        Padding="12,5"
                        Margin="5"
                        Click="SaveButton_Click"/>

                <Button Content="Restore"
                        Grid.Column="4"
                        Padding="12,5"
                        Margin="5"
                        Click="RestoreButton_Click"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
